{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "YOUR_SQL_CONNECTION_STRING",
    "Redis": "YOUR_REDIS_CONNECTION_STRING"
  },
  "Jwt": {
    "Key": "YOUR_JWT_SECRET_KEY_MIN_16_CHARS",
    "Issuer": "AIRecruitment",
    "ExpiryDays": 7
  },
  "AI": {
    "Provider": "minimax",
    "ApiKey": "YOUR_MINIMAX_API_KEY",
    "Model": "MiniMax-M2.7",
    "BaseUrl": "https://api.minimax.chat/v1/text/chatcompletion_v2",
    "UseMock": false
  },
  "MinIO": {
    "Endpoint": "YOUR_MINIO_ENDPOINT",
    "AccessKey": "YOUR_MINIO_ACCESS_KEY",
    "SecretKey": "YOUR_MINIO_SECRET_KEY",
    "BucketName": "recruitment-files"
  },
  "Neo4j": {
    "Uri": "bolt://localhost:7687",
    "User": "neo4j",
    "Password": "YOUR_NEO4J_PASSWORD"
  },
  "RabbitMQ": {
    "Enabled": false,
    "Host": "localhost",
    "UserName": "guest",
    "Password": "guest"
  },
  "TencentCloud": {
    "SecretId": "YOUR_TENCENT_SECRET_ID",
    "SecretKey": "YOUR_TENCENT_SECRET_KEY",
    "FaceRegion": "ap-beijing"
  },
  "Crawler": {
    "ApiKey": "YOUR_CRAWLER_API_KEY"
  },
  "HealthChecks": {
    "IntervalSeconds": 30,
    "Endpoints": [
      {
        "Name": "Self",
        "Url": "http://localhost:5000/api/stat/dashboard"
      }
    ]
  }
}